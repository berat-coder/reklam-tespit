# ─────────────────────────────────────────────────────────────────────────────
# OFİS İŞÇİSİ yapılandırması  →  bu dosyayı ofis makinesinde `.env` olarak kaydet
#
# Neden gerekli: YouTube, Railway'in datacenter IP'sinden video formatı vermiyor
# (denendi: 7 farklı player client, PO token, taze cookie, bölge değişimi — hepsi
# sıfır format). Normal bir internet bağlantısından ise sorunsuz çalışıyor.
# Bu yüzden yalnız yt-dlp + ffmpeg işi ofiste çalışır; panel/veritabanı/kareler
# Railway'de kalır ve 7/24 erişilebilir olmayı sürdürür.
#
# Değerleri Railway panelinden alacaksın (aşağıda hangisinin nereden alınacağı
# yazıyor). Bu dosyayı ASLA git'e ekleme — .env zaten .gitignore'da.
# ─────────────────────────────────────────────────────────────────────────────

# İş kuyruğu — Railway > Redis servisi > Variables > REDIS_PUBLIC_URL
# (İÇ adres olan REDIS_URL değil; ofisten bağlanacağı için PUBLIC olan.)
REDIS_URL=redis://default:PAROLA@HOST.proxy.rlwy.net:PORT

# Sonuçların yazılacağı veritabanı — Railway > Postgres > DATABASE_PUBLIC_URL
DATABASE_URL=postgresql://postgres:PAROLA@HOST.proxy.rlwy.net:PORT/railway

# Gemini anahtarı — Railway > web > Variables > GEMINI_API_KEY (aynısı)
GEMINI_API_KEY=

# Kanıt karelerinin yükleneceği panel adresi
FRAME_UPLOAD_URL=https://pitch.onstream.live

# Panel ile işçi arasındaki paylaşılan gizli anahtar.
# Aynı değer Railway > web > Variables > WORKER_TOKEN olarak da tanımlanmalı.
# Üretmek için:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_TOKEN=

# Cookie kullanma. Ev/ofis IP'sinde gerekmiyor; bayat cookie aksine engele yol
# açıyor (test edildi: cookie açıkken YouTube sıfır format döndürdü).
YT_USE_COOKIES=0

# Kareler önce buraya yazılır, sonra panele yüklenir (yerel geçici alan).
DATA_DIR=./worker-data
