# Bu dosyayı .env olarak kopyala ve değerleri doldur (docker-compose otomatik okur):
#   cp .env.example .env

# Gemini API anahtarı (zorunlu)
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube cookies — Netscape cookies.txt içeriğinin TAMAMI.
# Kolay yol: .env'i elle düzenle ve YOUTUBE_COOKIES="..." içine yapıştır.
YOUTUBE_COOKIES=

# Model & hız (opsiyonel — ücretsiz katman varsayılanları uygun)
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_RPM=15

# Not: REDIS_URL ve DATA_DIR docker-compose içinde otomatik ayarlanır.
